<Project>
	<!--
		Microsoft.AspNetCore.OpenApi ships its xml comment source generator as an analyzer, which reaches every
		consumer of this package, but ships the property that enables the interceptors it emits in build/ rather
		than buildTransitive/, which does not. Without this a consumer that generates a documentation file and
		does not reference Microsoft.AspNetCore.OpenApi directly fails to compile with CS9137.
	-->
	<PropertyGroup>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>
</Project>
