<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Chorn.AspNetCore.ProblemDetails.OpenApi</PackageId>
		<Title>ASP.NET Core Explained Problem Details for Microsoft.AspNetCore.OpenApi</Title>
		<Description>Documents the problems an endpoint declares with [ProducesProblems] as application/problem+json examples in the built-in ASP.NET Core open api document.</Description>
		<PackageTags>aspnetcore;problemdetails;problem-details;rfc9457;openapi;swagger;error-handling;webapi</PackageTags>
		<PackageReleaseNotes>
			v.0.9.1
			- No changes. Released alongside the core package, which fixes its analyzer.
			v.0.9.0
			- First release.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="../Shared/ProblemResponseDocumentation.cs" Link="ProblemResponseDocumentation.cs" />
		<ProjectReference Include="../Chorn.AspNetCore.ProblemDetails/Chorn.AspNetCore.ProblemDetails.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive/Chorn.AspNetCore.ProblemDetails.OpenApi.targets" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

</Project>
