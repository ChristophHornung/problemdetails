<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Chorn.AspNetCore.ProblemDetails.Swashbuckle</PackageId>
		<Title>ASP.NET Core Explained Problem Details for Swashbuckle</Title>
		<Description>Documents the problems an endpoint declares with [ProducesProblems] as application/problem+json examples in a Swashbuckle open api document.</Description>
		<PackageTags>aspnetcore;problemdetails;problem-details;rfc9457;swashbuckle;swagger;openapi;error-handling;webapi</PackageTags>
		<PackageReleaseNotes>
			v.0.9.0
			- First release.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="../Shared/ProblemResponseDocumentation.cs" Link="ProblemResponseDocumentation.cs" />
		<ProjectReference Include="..\Chorn.AspNetCore.ProblemDetails\Chorn.AspNetCore.ProblemDetails.csproj" />
	</ItemGroup>

</Project>
